{
    "name": "sparklink/email-errors-bundle",
    "description": "Symfony bundle to send errors by email",
    "type": "symfony-bundle",
    "license": "MIT",
    "version": "1.4.0",
    "homepage": "https://github.com/sparklink-pro/EmailErrorsBundle",
    "autoload": {
        "psr-4": {
            "Sparklink\\EmailErrorsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sparklink\\EmailErrorsBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Vincent Bouzeran",
            "email": "vincent@sparklink.pro"
        }
    ],
    "require": {},
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "psr/log": "^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/mailer": "^6.4 || ^7.0",
        "symfony/security-core": "^6.4 || ^7.0",
        "twig/twig": "^3.0",
        "monolog/monolog": "^3.0",
        "symfony/cache": "^6.4 || ^7.0"
    },
    "suggest": {
        "symfony/security-core": "Adds a \"Security\" panel (authenticated user, roles, session cookie) to error emails",
        "monolog/monolog": "Version 3: enables the \"email_errors.monolog_handler\" Monolog handler, to send log records by email",
        "psr/cache": "With the \"throttle\" option: the errors already sent are kept in the \"cache.app\" pool"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true"
        }
    }
}
